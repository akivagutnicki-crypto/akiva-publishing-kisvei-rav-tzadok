{
  "id": "./",
  "name": "SeferStudio Pro — Word DOCX, Publisher, PDF/OCR & Design",
  "short_name": "SeferStudio",
  "description": "Offline-capable Word (.docx) processor with true bottom-of-page footnotes & Ivrit BiDi, Publisher newsletters/flyers, PDF/OCR studio, Visual Design studio, and MCP Hub.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#185abd",
  "categories": [
    "productivity",
    "education",
    "graphics",
    "utilities"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/ogg": [
          ".ogg"
        ],
        "audio/webm": [
          ".webm"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Word & DOCX Studio",
      "url": "./index.html#/studio/word",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Publisher Flyer/Newsletter",
      "url": "./index.html#/studio/publisher",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "PDF & OCR Scanner",
      "url": "./index.html#/studio/pdf",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Audio Transcribe",
      "url": "./index.html#/studio/audio"
    }
  ]
}
