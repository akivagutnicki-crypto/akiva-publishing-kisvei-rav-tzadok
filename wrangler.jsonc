{
  // Browser-only setup: Cloudflare Workers & Pages > Create > Import repository.
  // This Worker serves the whole website as static assets (the publication mirrored to the site-latest release by
  // .github/workflows/site-mirror.yml, fetched by scripts/cf-build.sh at deploy) and exposes /mcp.
  "name": "akiva-publishing-kisvei-rav-tzadok",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "build": { "command": "bash scripts/cf-build.sh" },
  // Files are served first; the Worker runs for /mcp, /health, /ask and the few files over 25 MB (redirected).
  "assets": { "directory": "./site", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  // Cloudflare Workers AI, for /ask (short written answers in the reader's Mafteach search)
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "STUDIO_SESSIONS", "class_name": "SeferStudioSession" }, { "name": "SOFER_KEY_STORE", "class_name": "SoferKeyStore" }] },
  "migrations": [{ "tag": "sefer-studio-session-v1", "new_sqlite_classes": ["SeferStudioSession"] }, { "tag": "sofer-key-store-v1", "new_sqlite_classes": ["SoferKeyStore"] }],
  // OCR-only approximate allowance per Cloudflare location; no caller-controlled key.
  "ratelimits": [
    { "name": "OCR_RATE_LIMITER", "namespace_id": "76118001", "simple": { "limit": 5, "period": 60 } },
    { "name": "STUDIO_RATE_LIMITER", "namespace_id": "76118002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Workers Paid: a library-wide search reads one index file per book and field (over 50 subrequests)
  "limits": { "subrequests": 10000 },
  "vars": {
    "MCP_SITE_ORIGIN": "https://akivagutnicki-crypto.github.io/akiva-publishing-kisvei-rav-tzadok",
    "OCR_ALLOWED_ORIGINS": "https://akivagutnicki-crypto.github.io,https://akiva-publishing-kisvei-rav-tzadok.akivagutnicki.workers.dev",
    // SHA-256 verifier only; the private 256-bit service code is not in source.
    "OCR_ACCESS_TOKEN_SHA256": "9e30c3d563ebd726769c450f87459ca041166e6d23c2a5abe479802294aee05c"
  }
}
