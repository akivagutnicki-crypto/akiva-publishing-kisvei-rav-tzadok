], ["(בְּפֶתַח אֵלִיָּהוּ,", "(in Pesach Eliyahu,"], ["תִּקּוּנֵי זֹהַר, הַקְדָּמָה יז, א):", "Tikkunei Zohar, Introduction 17a):"], ["״בִּינָה לִבָּא״.", "\"Binah is the heart.\""], ["מַעַשְׂרוֹת כְּנֶגֶד גְּבוּרָה,", "Maasros correspond to Gevurah,"], ["שֶׁיִּצְחָק אָבִינוּ עָלָיו הַשָּׁלוֹם", "for Yitzchak Avinu, peace be upon him,"], ["מֶרְכָּבָה לָהּ,", "is a chariot for it,"], ["וּבְיִצְחָק מָצִינוּ", "and with Yitzchak we find"], ["עִנְיַן מַעַשְׂרוֹת.", "the matter of maasros."], ["אַף דְּבְאַבְרָהָם גַּם כֵּן מָצִינוּ,", "Although with Avraham too we find it,"], ["דִּכְתִיב בֵּיהּ:", "for it is written of him:"], ["״וַיִּתֶּן לוֹ מַעֲשֵׂר מִכֹּל״", "\"And he gave him a tithe of everything\""], ["(בְּרֵאשִׁית יד, כ),", "(Bereishis 14:20),"], ["שָׁם הָיָה מֵהַשָּׁלָל", "there it was from the spoils"], ["שֶׁנָּפַל לוֹ", "that fell to him"], ["בְּפַעַם אֶחָד,", "all at once,"], ["וְגַם לֹא רָצָה בּוֹ כְּלָל,", "and moreover he did not want it at all,"], ["כְּמוֹ שֶׁאָמַר לְמֶלֶךְ סְדוֹם:", "as he said to the king of Sedom:"], ["״הֲרִימוֹתִי וְגוֹמֵר״", "\"I have raised up,\" etc."], ["(בְּרֵאשִׁית יד, כב–כג).", "(Bereishis 14:22–23)."], ["וְיַעֲקֹב שֶׁאָמַר גַּם כֵּן:", "And Yaakov, who also said:"], ["״וְכֹל אֲשֶׁר תִּתֶּן לִי", "\"And of all that You give me"], ["עַשֵּׂר אֲעַשְּׂרֶנּוּ לָךְ״", "I will surely tithe to You\""], ["(בְּרֵאשִׁית כח, כב),", "(Bereishis 28:22),"], ["הָיָה גַּם כֵּן", "that too was"], ["מֵאֲשֶׁר יִתֵּן לוֹ ה׳.", "from what Hashem would give him."], ["וְעִקַּר מַעֲשֵׂר", "But the essential tithe"], ["הוּא מַעֲשַׂר גּוֹרֶן,", "is the tithe of the threshing floor,"], ["מִמַּה שֶּׁהָאָדָם זוֹרֵעַ", "from what a person sows,"], ["וּמַאֲמִין", "and he believes"], ["שֶׁאַף שֶׁהוּא עוֹשֶׂה פְּעוּלָּה וְזוֹרֵעַ,", "that although he takes action and sows,"], ["הוּא רַק מֵהַשֵּׁם יִתְבָּרַךְ.", "it is only from Hashem, may He be blessed."], ["שֶׁמִּטַּעַם זֶה אָמְרוּ", "For this is why they said"], ["(שַׁבָּת לא, א):", "(Shabbos 31a):"], ["״׳אֱמוּנַת׳ –", "\"'The faith of' –"], ["זֶה סֵדֶר זְרָעִים״,", "this is Seder Zeraim,\""], ["וּבְתוֹסָפוֹת", "and in Tosafos"], ["(שָׁם, דִּבּוּר הַמַּתְחִיל אֱמוּנַת)", "(there, s.v. emunas)"], ["בְּשֵׁם הַיְרוּשַׁלְמִי:", "in the name of the Yerushalmi:"], ["״שֶׁמַּאֲמִין בְּחֵי הָעוֹלָמִים", "\"for he believes in the Life of the worlds"], ["וְזוֹרֵעַ״.", "and sows.\""], ["וְהַיְינוּ", "That is to say:"], ["דְּאֻמּוֹת הָעוֹלָם זוֹרְעִין", "the nations of the world sow"], ["עַל סְמַךְ זֶה", "relying on this,"], ["שֶׁאַחַר הַזְּרִיעָה", "that after the sowing"], ["יִצְמַח עַל פִּי הַטֶּבַע;", "it will grow according to nature;"], ["אֲבָל יִשְׂרָאֵל מַאֲמִינִים", "but Yisrael believe"], ["שֶׁאַף שֶׁזּוֹרֵעַ וְצוֹמֵחַ,", "that although one sows and it grows,"], ["הוּא רַק מִכֹּחַ", "it is only by the power"], ["חֵי הָעוֹלָמִים,", "of the Life of the worlds,"], ["וְאֵין תּוֹלִין בַּטֶּבַע.", "and they do not attribute it to nature."], ["וּבְיִצְחָק אָבִינוּ עָלָיו הַשָּׁלוֹם", "And with Yitzchak Avinu, peace be upon him,"], ["מָצִינוּ:", "we find:"], ["״וַיִּזְרַע יִצְחָק", "\"And Yitzchak sowed"], ["וַיִּמְצָא מֵאָה שְׁעָרִים״", "and found a hundredfold\""], ["(בְּרֵאשִׁית כו, יב),", "(Bereishis 26:12),"], ["וְאִיתָא", "and it is stated"], ["(בְּרֵאשִׁית רַבָּה סד, ו):", "(Bereishis Rabbah 64:6):"], ["״אוֹמֶד זֶה", "\"This estimate"], ["לְמַעַשְׂרוֹת הָיָה״.", "was for the sake of maasros.\""], ["וְהוּא כְּנֶגֶד מִדַּת גְּבוּרָה,", "And this corresponds to the middah of Gevurah,"], ["וְ״אֵיזֶהוּ גִּבּוֹר?", "and \"Who is mighty?"], ["הַכּוֹבֵשׁ אֶת יִצְרוֹ״", "He who conquers his yetzer\""], ["(אָבוֹת ד, א);", "(Avos 4:1);"], ["שֶׁהַיֵּצֶר הָרַע", "for the yetzer hara"], ["מְסַמֵּא אֶת עֵינֵי הָאָדָם", "blinds a person's eyes"], ["לוֹמַר עַל הַכֹּל:", "so that he says of everything:"], ["מִקְרֶה הוּא", "it is chance"], ["וְדֶרֶךְ הַטֶּבַע.", "and the way of nature."], ["וְקָרְבָּנוֹת כְּנֶגֶד הוֹד,", "And korbanos correspond to Hod,"], ["שֶׁאַהֲרֹן הַכֹּהֵן", "for Aharon HaKohen"], ["מֶרְכָּבָה לְמִדַּת הוֹד,", "is a chariot for the middah of Hod,"], ["וְהוּא הָיָה שׁוֹרֶשׁ", "and he was the root"], ["כָּל הַקָּרְבָּנוֹת,", "of all the korbanos,"], ["שֶׁהַהַקְרָבָה הָיָה עַל יָדוֹ.", "for the offering was done through him."], ["וְנֶגֶד קַו הָאֶמְצָעִי,", "And corresponding to the middle line,"], ["כֶּתֶר תִּפְאֶרֶת יְסוֹד מַלְכוּת,", "Kesser, Tiferes, Yesod, Malchus,"], ["חָשַׁב בַּמִּדְרָשׁ", "the Midrash lists"], ["יְרוּשָׁלַיִם שְׁבָטִים", "Yerushalayim, the Shevatim,"], ["יְהוּדָא וְיִשְׂרָאֵל.", "Yehudah and Yisrael."], ["יְרוּשָׁלַיִם,", "Yerushalayim,"], ["שֶׁקְּדוּשָּׁתוֹ לִפְנִים מִן הַחוֹמָה,", "whose holiness is within the wall,"], ["בְּחִינַת אוֹר מַקִּיף,", "is the aspect of the encompassing light,"], ["כְּנֶגֶד מִדַּת כֶּתֶר,", "corresponding to the middah of Kesser,"], ["שֶׁהוּא גַּם כֵּן", "which is also"], ["בְּחִינַת אוֹר מַקִּיף.", "the aspect of the encompassing light."], ["וּשְׁבָטִים כְּנֶגֶד מִדַּת תִּפְאֶרֶת,", "And the Shevatim correspond to the middah of Tiferes,"], ["כְּמוֹ שֶׁכָּתוּב", "as is written"], ["(בְּפֶתַח אֵלִיָּהוּ):", "(in Pesach Eliyahu):"], ["״תִּפְאֶרֶת גּוּפָא״,", "\"Tiferes is the body,\""], ["מִדַּת יַעֲקֹב אָבִינוּ עָלָיו הַשָּׁלוֹם.", "the middah of Yaakov Avinu, peace be upon him."], ["וְיַעֲקֹב צוּרָתוֹ", "And Yaakov's image"], ["חֲקוּקָה בְּכִסֵּא הַכָּבוֹד", "is engraved on the Throne of Glory"], ["(רְאֵה חֻלִּין צא, ב),", "(see Chullin 91b),"], ["וְהָיָה כְּמוֹ אָדָם הָרִאשׁוֹן", "and he was like Adam HaRishon"], ["קוֹדֶם הַחֵטְא.", "before the sin."], ["וְ״גוּפָא״", "And \"the body\""], ["הַיְינוּ שְׁנֵים עָשָׂר שִׁבְטֵי יָ־הּ,", "means the twelve tribes of Kah,"], ["שֶׁעֲלֵיהֶם כְּתִיב:", "regarding whom it is written:"], ["״וַיִּגַּע בְּכַף יְרֵכוֹ״", "\"And he touched the hollow of his thigh\""], ["(בְּרֵאשִׁית לב, כו),", "(Bereishis 32:26),"], ["שֶׁעֲלֵיהֶם הָיָה יָכוֹל", "for regarding them he was able"], ["לִמְצוֹא טַעֲנָה,", "to find a claim,"], ["וְהֵם בָּאוּ לְתַקֵּן זֹ