ּׁלֹשָׁה אָבוֹת,", "the three Avos"], ["עַל פִּי הַמִּדְרָשׁ", "is according to the Midrash"], ["(וַיִּקְרָא רַבָּה כא, יא):", "(Vayikra Rabbah 21:11):"], ["״׳בְּפַר בֶּן בָּקָר׳", "\"'With a young bull'"], ["(וַיִּקְרָא טז, ג) –", "(Vayikra 16:3) –"], ["זֶה אַבְרָהָם", "this is Avraham,"], ["וְכוּלֵּי;", "and so on;"], ["׳וְאַיִל לְעֹלָה׳ –", "'and a ram for an olah' –"], ["זֶה יִצְחָק", "this is Yitzchak,"], ["וְכוּלֵּי;", "and so on;"], ["׳עֵז׳ –", "'a goat' –"], ["בִּזְכוּתוֹ שֶׁל יַעֲקֹב", "in the merit of Yaakov,"], ["וְכוּלֵּי״,", "and so on,\""], ["שֶׁנִּכְנַס עִמּוֹ", "that there entered with him"], ["זְכוּת הָאָבוֹת.", "the merit of the Avos."], ["וְעַל זֶה הִזְכִּיר", "And on this basis he mentioned"], ["שֶׁנִּמְצָא בַּדּוֹר שֶׁלּוֹ", "that there are found in his generation"], ["גַּם כֵּן הַקְּרוּיִם", "also those called"], ["בִּשְׁמוֹת הָאָבוֹת הַקְּדוֹשִׁים,", "by the names of the holy Avos,"], ["שֶׁהֵם בִּבְחִינָתָם;", "who are in their aspect;"], ["וְהַכַּוָּנוֹת", "and the kavanos"], ["יָכוֹל לְכַוֵּין,", "he is able to have in mind,"], ["כְּמוֹ שֶׁהָיוּ מְכַוְּנִים", "just as the great ones of the generation"], ["גְּדוֹלֵי הַדּוֹר", "would have them in mind"], ["בִּזְמַן שֶׁלֹּא הָיָה הַכֹּהֵן גָּדוֹל", "at a time when the Kohen Gadol was not"], ["רָאוּי לְכָךְ,", "fit for this,"], ["כַּנִּזְכָּר לְעֵיל.", "as mentioned above."], ["וְכֵיוָן שֶׁיָּכוֹל לִהְיוֹת", "And since it is possible for"], ["הַכַּוָּנוֹת עַל יְדֵי אַחֵר,", "the kavanos to be done by another,"], ["אָמַר שֶׁאֵין הַקָּרְבָּנוֹת", "he said that the korbanos"], ["מְעַכְּבִין.", "are not indispensable."], ["וְאִיתָא בַּמִּדְרָשׁ", "And it is stated in the Midrash"], ["(בְּרֵאשִׁית רַבָּה נו, ז):", "(Bereishis Rabbah 56:7):"], ["״אֵין דּוֹר", "\"There is no generation"], ["שֶׁאֵין בּוֹ כְּאַבְרָהָם", "that does not have one like Avraham,\""], ["וְכוּלֵּי״,", "and so on;"], ["וּבְתַנָּא דְּבֵי אֵלִיָּהוּ:", "and in Tanna Devei Eliyahu:"], ["״אֵין דּוֹר שֶׁאֵין בּוֹ", "\"There is no generation that does not have"], ["כְּאַבְרָהָם יִצְחָק וְיַעֲקֹב״;", "ones like Avraham, Yitzchak and Yaakov\";"], ["רַק שֶׁאֵין אָנוּ יוֹדְעִין", "only that we do not know"], ["מִי הֵם.", "who they are."], ["וְהֵם יְכוֹלִים לְכַוֵּין", "And they are able to have in mind"], ["כָּל הַכַּוָּנוֹת", "all the kavanos"], ["הָרְאוּיִן לְכֹהֵן גָּדוֹל.", "that befit the Kohen Gadol."], ["וְאַף שֶׁאֵין לָנוּ", "And although we do not have"], ["הַקָּרְבָּנוֹת,", "the korbanos,"], ["מִכָּל מָקוֹם כְּשֶׁנִּזְכֶּה,", "nevertheless, when we merit,"], ["נוּכַל לְתַקֵּן", "we will be able to rectify"], ["עַל יְדֵיהֶם,", "through them,"], ["שֶׁהֵם יְכַוְּונוּ", "for they will have in mind"], ["הַמְכוּוָּן שֶׁל הַקָּרְבָּנוֹת,", "the intent of the korbanos,"], ["וּלְתַקֵּן הַכֹּל", "and to rectify everything"], ["בְּיוֹם הַכִּפּוּרִים,", "on Yom Kippur,"], ["כְּמוֹ שֶׁהָיָה מְתַקֵּן", "just as the Kohen Gadol"], ["הַכֹּהֵן גָּדוֹל", "would rectify"], ["בְּהַכְנָסָתוֹ לְקֹדֶשׁ הַקֳּדָשִׁים;", "upon his entering the Holy of Holies;"], ["וּכְדִבְרֵי הַמַּגִּיד הַקָּדוֹשׁ", "and in accordance with the words of the holy Maggid,"], ["זֵכֶר צַדִּיק לִבְרָכָה.", "may the memory of the tzaddik be a blessing."]]}
