[{"h":"לְעֶרֶב יוֹם הַכִּפּוּרִים, ג׳ Erev Yom Kippur, 3","unit":"h57"},{"p":[["בַּמִּדְרָשׁ","In the Midrash"],["(וַיִּקְרָא רַבָּה כא, יב)","(Vayikra Rabbah 21:12)"],["עַל פָּסוּק:","on the pasuk:"],["״וְכָל אָדָם לֹא יִהְיֶה","\"And no man shall be"],["בְּאֹהֶל מוֹעֵד״","in the Ohel Moed\""],["(וַיִּקְרָא טז, יז):","(Vayikra 16:17):"],["״בַּשָּׁנָה שֶׁמֵּת בָּהּ","\"In the year in which"],["שִׁמְעוֹן הַצַּדִּיק","Shimon HaTzaddik died,"],["וְכוּלֵּי,","and so on,"],["אָמַר לָהֶם:","he said to them:"],["בְּכָל שָׁנָה וְשָׁנָה","Every single year"],["הָיָה זָקֵן אֶחָד","there was an elder"],["לָבוּשׁ לְבָנִים","clothed in white"],["וְכוּלֵּי;","and so on;"],["שָׁנָה זוֹ נִכְנַס עִמִּי","this year he entered with me"],["וְלֹא יָצָא עִמִּי.","but did not go out with me."],["אָמַר רַבִּי אַבָּהוּ:","Rabbi Abahu said:"],["וּמִי יֹאמַר","And who will say"],["שֶׁאָדָם הָיָה,","that it was a human being,"],["וְלֹא הַקָּדוֹשׁ בָּרוּךְ הוּא","and not the Holy One, blessed is He,"],["בִּכְבוֹדוֹ","in His glory,"],["הָיָה נִכְנָס וְיוֹצֵא עִמּוֹ?","who entered and went out with him?"],["אָמַר רַבִּי אַבָּהוּ:","Rabbi Abahu said:"],["וְכֹהֵן גָּדוֹל","And the Kohen Gadol –"],["לֹא אָדָם הָיָה,","he was not a human being,"],["אֶלָּא כְּהַהוּא","but rather it is like that which"],["דְּאָמַר רַבִּי פִּנְחָס:","Rabbi Pinchas said:"],["בְּשָׁעָה שֶׁהָיָה רוּחַ הַקֹּדֶשׁ","When the holy spirit"],["שׁוֹרָה עָלָיו,","rested upon him,"],["הָיוּ פָּנָיו בּוֹעֲרוֹת","his face would burn"],["כְּלַפִּידִים;","like torches;"],["הֲדָא הוּא דִכְתִיב:","this is what is written:"],["׳כִּי שִׂפְתֵי כֹהֵן","'For the lips of the kohen"],["יִשְׁמְרוּ דַעַת","shall guard knowledge,"],["וְגוֹמֵר,","etc.,"],["כִּי מַלְאַךְ ה׳ צְבָאוֹת הוּא׳״","for he is a messenger of Hashem of Hosts'\""],["(מַלְאָכִי ב, ז).","(Malachi 2:7)."],["וּכְבָר תָּמַהּ","And the Matnos Kehunah"],["הַמַּתְּנוֹת כְּהֻנָּה:","has already wondered:"],["דִּמְקוֹדֶם אָמַר רַבִּי אַבָּהוּ","for first Rabbi Abahu said"],["שֶׁהָיָה הַקָּדוֹשׁ בָּרוּךְ הוּא בִּכְבוֹדוֹ,","that it was the Holy One, blessed is He, in His glory,"],["לְיַישֵּׁב מַה שֶּׁנֶּאֱמַר:","to resolve what is said:"],["״וְכָל אָדָם לֹא יִהְיֶה״,","\"And no man shall be,\""],["וְכִדְרָשַׁת הַיְרוּשַׁלְמִי","according to the exposition of the Yerushalmi"],["(יְרוּשַׁלְמִי יוֹמָא ה, ב):","(Yerushalmi Yoma 5:2):"],["״אֲפִילּוּ אוֹתָן שֶׁכָּתַב בָּהֶן:","\"even those of whom it is written:"],["׳וּדְמוּת פְּנֵיהֶם פְּנֵי אָדָם׳״","'and the likeness of their faces was the face of a man'\""],["(יְחֶזְקֵאל א, י);","(Yechezkel 1:10);"],["וְאַחַר כָּךְ מְסַיֵּים עַל שְׁאֵלָתוֹ:","and afterward he concludes on his question:"],["״וְכֹהֵן גָּדוֹל","\"And the Kohen Gadol"],["לָאו אָדָם הָיָה״,","was not a human being,\""],["אֶלָּא שֶׁהָיָה מַלְאָךְ –","but rather that he was an angel –"],["נִרְאֶה שֶׁחָזַר בּוֹ","it appears that he retracted"],["וּפֵירֵשׁ ״וְכָל אָדָם״","and explained \"and no man\""],["כְּמַשְׁמָעוֹ.","in its plain sense."],["וְקָשֶׁה לוֹמַר","And it is difficult to say"],["עַל רַבִּי אַבָּהוּ,","of Rabbi Abahu,"],["שֶׁהוּא בְּעַצְמוֹ","that he himself"],["אָמַר שְׁנֵי הַמַּאֲמָרִים,","said both statements,"],["שֶׁחָזַר בּוֹ.","that he retracted."],["אַךְ הָעִנְיָן,","But the matter is"],["שֶׁהַכֹּהֵן גָּדוֹל","that the Kohen Gadol,"],["בִּכְנִיסָתוֹ לְקֹדֶשׁ הַקֳּדָשִׁים,","upon his entry into the Holy of Holies,"],["לֹא הָיָה לוֹ שׁוּם גּוּף","had no body at all"],["מֵעוֹלָם הַזֶּה,","of this world,"],["שֶׁהָיָה לוֹ הִתְפַּשְּׁטוּת הַגַּשְׁמִיּוּת","for he had divested himself of physicality"],["לְגַמְרֵי,","completely,"],["וְהָיָה נִשְׁאַר בּוֹ","and there remained in him"],["רַק בְּחִינַת נְשָׁמָה:","only the aspect of the neshamah:"],["״נֵר ה׳ נִשְׁמַת אָדָם״","\"The soul of man is the lamp of Hashem\""],["(מִשְׁלֵי כ, כז).","(Mishlei 20:27)."],["דְּאַהֲרֹן הַכֹּהֵן","For Aharon HaKohen"],["הָיָה שֹׁרֶשׁ תּוֹרָה שֶׁבְּעַל פֶּה,","was the root of the Torah she'b'al peh,"],["דִּכְתִיב:","as it is written:"],["״כִּי שִׂפְתֵי כֹהֵן יִשְׁמְרוּ דַעַת","\"For the lips of the kohen shall guard knowledge,"],["וְתוֹרָה יְבַקְשׁוּ מִפִּיהוּ״,","and they shall seek Torah from his mouth,\""],["וְהַיְינוּ ״פִּי ה׳״.","and that is \"the mouth of Hashem.\""],["וּכְמוֹ שֶׁאָמְרוּ","And as is said"],["בַּזֹּהַר הַקָּדוֹשׁ","in the holy Zohar"],["(זֹהַר חֵלֶק ג רא, ב):","(Zohar III 201b):"],["״אִתְקַדַּשׁ יוֹמָא,","\"When the day became sanctified,"],["סָלֵיק פּוּמָא","there arose the mouth"],["דְּשַׁלִּיט עַל כּוּלָּא,","that rules over all,"],["פִּי ה׳״.","the mouth of Hashem.\""],["וּבְסֵפֶר יְצִירָה","And in Sefer Yetzirah"],["(פֶּרֶק ד)","(chapter 4)"],["חָשַׁב","it reckons"],["שֶׁבְּשַׁבָּת נִבְרָא","that on Shabbos was created"],["פֶּה בַּנֶּפֶשׁ;","the mouth in the soul;"],["וּבְוַדַּאי הָיָה","yet surely there was"],["לְאָדָם הָרִאשׁוֹן הַפֶּה","a mouth for Adam HaRishon"],["גַּם בְּעֶרֶב שַׁבָּת,","also on Erev Shabbos,"],["שֶׁהֲרֵי דִּיבֵּר אָדָם הָרִאשׁוֹן","for Adam HaRishon spoke"],["בְּעֶרֶב שַׁבָּת","on Erev Shabbos"],["עִם הַשֵּׁם יִתְבָּרַךְ","with Hashem, may He be blessed"],["(בְּרֵאשִׁית ג, ט–יב),","(Bereishis 3:9–12),"],["וְקָרָא שֵׁמוֹת","and gave names"],["(בְּרֵאשִׁית ב, כ).","(Bereishis 2:20)."],["רַק ״פִּי ה׳״,","Rather, \"the mouth of Hashem,\""],["הַיְינוּ בְּחִינַת","that is, the aspect of"],["תּוֹרָה שֶׁבְּעַל פֶּה,","Torah she'b'al peh,"],["שֶׁזֶּה נִבְרָא בְּשַׁבָּת,","this was created on Shabbos,"],["כְּמוֹ שֶׁכָּתוּב","as is written"],["בַּזֹּהַר הַקָּדוֹשׁ","in the holy Zohar"],["(זֹהַר חֵלֶק א מז, ב):","(Zohar I 47b):"],["״׳וַיְכַל אֱלֹהִים","\"'And Elokim completed"],["בַּיּוֹם הַשְּׁבִיעִי׳","on the seventh day'"],["(בְּרֵאשִׁית ב, ב) –","(Bereishis 2:2) –"],["דָּא תּוֹרָה שֶׁבְּעַל פֶּה״.","this is the Torah she'b'al peh.\""],["וּבְשַׁבָּת,","And on Shabbos,"],["דְּאִיתָא בַּזֹּהַר הַקָּדוֹשׁ","of which it is stated in the holy Zohar"],["(זֹהַר חֵלֶק ב רה, א)","(Zohar II 205a)"],["שֶׁהוּא ״יוֹמָא דְּנִשְׁמָתִין","that it is \"a day of souls"],["וְלָאו יוֹמָא דְּגוּפָא״,","and not a day of the body,\""],["אָז בְּכֹחַ הָאָדָם","then it is in a person's power"],["לְדַבֵּר דָּבָר","to speak a word"],["שֶׁיִּהְיֶה","that will be"],["״דִּבְרֵי אֱלֹהִים חַיִּים״,","\"the words of the living Elokim,\""],["וְיִהְיֶה נִקְרָא ״פִּי ה׳״;","and it will be called \"the mouth of Hashem\";"],["שֶׁהַשֵּׁם יִתְבָּרַךְ","for Hashem, may He be blessed,"],["שׁוֹכֵן בַּלֵּב,","dwells in the heart,"],["כְּמוֹ שֶׁאָמְרוּ","as they said"],["(שִׁיר הַשִּׁירִים רַבָּה ה, ב):","(Shir HaShirim Rabbah 5:2):"],["״הֵיכָן מָצִינוּ","\"Where do we find"],["שֶׁנִּקְרָא הַקָּדוֹשׁ בָּרוּךְ הוּא","that the Holy One, blessed is He, is called"],["לִבָּן שֶׁל יִשְׂרָאֵל?","the heart of Yisrael?"],["דִּכְתִיב:","For it is written:"],["׳צוּר לְבָבִי וְחֶלְקִי","'The Rock of my heart and my portion"],["אֱלֹהִים לְעוֹלָם׳״","is Elokim forever'\""],["(תְּהִלִּים עג, כו).","(Tehillim 73:26)."],["וְהַפֶּה שְׁלִיחַ הַלֵּב;","And the mouth is the messenger of the heart;"],["וְעַל זֶה נֶאֱמַר:","and regarding this it says:"],["״כִּי שִׂפְתֵי כֹהֵן יִשְׁמְרוּ דַעַת","\"For the lips of the kohen shall guard knowledge,"],["וְתוֹרָה יְבַקְשׁוּ מִפִּיהוּ,","and they shall seek Torah from his mouth,"],["כִּי מַלְאַךְ ה׳ צְבָאוֹת הוּא״.","for he is a messenger of Hashem of Hosts.\""],["פֵּרוּשׁ:","Meaning:"],["״מַלְאַךְ ה׳ צְבָאוֹת הוּא״","\"he is a messenger of Hashem of Hosts\""],["קָאֵי עַל הַתּוֹרָה","refers to the Torah"],["שֶׁיְּבַקְשׁוּ מִפִּיהוּ,","that they shall seek from his mouth,"],["שֶׁהוּא ״מַלְאַךְ ה׳״,","which is \"the messenger of Hashem,\""],["הַיְינוּ שְׁלִיחַ הַלֵּב,","that is, the messenger of the heart,"],["שֶׁהוּא הַשֵּׁם יִתְבָּרַךְ,","which is Hashem, may He be blessed,"],["שֶׁנִּקְרָא","who is called"],["״צוּר לְבָבִי וְחֶלְקִי","\"the Rock of my heart and my portion,"],["אֱלֹהִים לְעוֹלָם״.","Elokim forever.\""],["אֲבָל הַכֹּהֵן גָּדוֹל","But the Kohen Gadol,"],["כְּשֶׁנִּכְנַס לְקֹדֶשׁ הַקֳּדָשִׁים,","when he entered the Holy of Holies,"],["שָׁם נִתְפַּשֵּׁט","there he was divested"],["מִכָּל גֶּשֶׁם","of all physicality"],["וְעִנְיְנֵי הַגּוּף,","and bodily matters,"],["וְהָיָה רַק כִּנְשָׁמָה","and he was only like a soul"],["בְּלֹא גּוּף;","without a body;"],["וּכְמוֹ שֶׁנֶּאֱמַר:","and as it says:"],["״וַיִּפַּח בְּאַפָּיו","\"And He breathed into his nostrils"],["נִשְׁמַת חַיִּים״","the soul of life\""],["(בְּרֵאשִׁית ב, ז),","(Bereishis 2:7),"],["וְאִיתָא בַּתִּיקּוּנִים:","and it is stated in the Tikkunim:"],["״מַאן דְּנָפַח","\"One who blows"],["מִתּוֹכוֹ נָפַח״.","blows from within himself.\""],["וְלֹא הָיָה כְּלָל","And he was not at all"],["בִּכְלַל אָדָם,","within the category of \"man,\""],["אֲפִילּוּ כְּאוֹתָן","not even like those"],["שֶׁכָּתַב בָּהֶן:","of whom it is written:"],["״וּדְמוּת פְּנֵיהֶם פְּנֵי אָדָם״,","\"and the likeness of their faces was the face of a man,\""],["שֶׁהָיָה אָז","for he was then"],["גָּדוֹל מִמַּלְאָךְ.","greater than an angel."],["וְשָׁם בְּקֹדֶשׁ הַקֳּדָשִׁים","And there in the Holy of Holies"],["לֹא הָיָה לוֹ","he had"],["שׁוּם דִּיבּוּר כְּלָל,","no speech at all,"],["שֶׁהַתְּפִלָּה שֶׁהָיָה מִתְפַּלֵּל","for the prayer he would pray"],["הָיָה בַּהֵיכָל,","was in the Heichal,"],["כְּמוֹ שֶׁאָמְרוּ","as they said"],["(יוֹמָא נב, ב).","(Yoma 52b)."],["וְשַׁפִּיר כְּתִיב:","And it is well written:"],["״וְכָל אָדָם לֹא יִהְיֶה","\"And no man shall be,\""],["וְגוֹמֵר״.","etc."],["וְהוּא גַּם כֵּן בִּכְלַל","And this is also included in"],["מַה שֶּׁאָמַר:","what he said:"],["״הַקָּדוֹשׁ בָּרוּךְ הוּא בִּכְבוֹדוֹ","\"The Holy One, blessed is He, in His glory"],["הָיָה נִכְנָס עִמּוֹ","would enter with him,\""],["וְכוּלֵּי״.","and so on."],["וּמִטַּעַם זֶה","And for this reason"],["נִקְרָא הַכֹּהֵן גָּדוֹל","the Kohen Gadol is called"],["בְּכָל סֵדֶר הַיּוֹם","throughout the Order of the Day"],["(בְּמִשְׁנָיוֹת יוֹמָא)","(in the Mishnayos of Yoma)"],["״אִישִׁי כֹּהֵן גָּדוֹל״,","\"My master the Kohen Gadol\" (ishi),"],["שֶׁהוּא מִלְּשׁוֹן ״אֵשׁ״;","which is from the word \"eish\" (fire);"],["שֶׁאָז הָיָה כֹּהֵן גָּדוֹל","for then the Kohen Gadol was"],["בִּבְחִינַת ״אֵשׁ אוֹכְלָה״,","in the aspect of \"a consuming fire,\""],["אֵשׁ נִשְׁמְתָא","the fire of the soul"],["בְּלֹא גּוּפָא.","without the body."],["וְלָכֵן בַּפַּעַם הָאַחֲרוֹן","And therefore, the last time"],["שֶׁהוּזְכַּר","that it is mentioned"],["(יוֹמָא עא, א):","(Yoma 71a):"],["״מְצָאוֹ בַּשּׁוּק","\"If he found him in the marketplace,"],["לְכֹהֵן גָּדוֹל,","the Kohen Gadol,"],["אָמַר לוֹ:","he said to him:"],["אִישִׁי כֹּהֵן גָּדוֹל,","My master the Kohen Gadol,"],["עָשִׂיתִי שְׁלִיחוּתְךָ","I have carried out your mission,\""],["וְכוּלֵּי״,","and so on –"],["אִיתָא שָׁם","there is stated there"],["אַחַר כָּךְ","afterward"],["דְּרָשַׁת הַגְּמָרָא","the Gemara's exposition"],["עַל פָּסוּק:","of the pasuk:"],["״אֲלֵיכֶם אִישִׁים אֶקְרָא״","\"To you, men (ishim), I call\""],["(מִשְׁלֵי ח, ד) –","(Mishlei 8:4) –"],["״אֵלּוּ תַּלְמִידֵי חֲכָמִים","\"these are talmidei chachamim,\""],["וְכוּלֵּי,","and so on;"],["הָרוֹצֶה לְנַסֵּךְ יַיִן","\"one who wishes to pour a wine libation,\""],["וְכוּלֵּי״.","and so on."],["דְּהַתַּלְמִידֵי חֲכָמִים","For talmidei chachamim"],["נִקְרְאוּ ״אִישִׁים״,","are called \"ishim,\""],["שֶׁמְּדַבְּרִים דָּבָר","for they speak a word"],["וְהוּא ״פִּי ה׳״,","and it is \"the mouth of Hashem,\""],["שֶׁהַדִּיבּוּרִים שֶׁלָּהֶם","for their words"],["הֵם ״מַלְאַךְ ה׳״,","are \"the messenger of Hashem,\""],["שְׁלִיחַ הַלֵּב,","the messenger of the heart,"],["שֶׁהוּא הַקָּדוֹשׁ בָּרוּךְ הוּא","which is the Holy One, blessed is He,"],["הַשּׁוֹכֵן בְּתוֹכָם,","Who dwells within them,"],["כְּמוֹ שֶׁנֶּאֱמַר:","as it says:"],["״צוּר לְבָבִי וְחֶלְקִי","\"The Rock of my heart and my portion,\""],["וְגוֹמֵר״.","etc."],["וְאַף שֶׁלֹּא כָּל כֹּהֵן גָּדוֹל","And although not every Kohen Gadol"],["הָיָה רָאוּי לָזֶה,","was fit for this,"],["שֶׁיִּתְפַּשֵּׁט כָּל כָּךְ","to be divested so completely"],["מִכָּל מִינֵי גַּשְׁמִיּוּת הַגּוּף","of every kind of bodily physicality"],["עַד שֶׁיִּהְיֶה","until he would be"],["כִּנְשָׁמָה בְּלֹא גּוּף,","like a soul without a body,"],["וּמִכָּל מָקוֹם","and nevertheless"],["נִכְנְסוּ לְקֹדֶשׁ הַקֳּדָשִׁים –","they entered the Holy of Holies –"],["כְּבָר אִיתָא","it is already stated"],["בְּסֵפֶר עֲבוֹדַת יִשְׂרָאֵל","in the sefer Avodas Yisrael"],["(לְיוֹם הַכִּפּוּרִים)","(for Yom Kippur)"],["פֵּרוּשׁ עַל הַגְּמָרָא","an explanation of the Gemara"],["(יוֹמָא עא, ב)","(Yoma 71b)"],["שֶׁהֵשִׁיבוּ שְׁמַעְיָה וְאַבְטַלְיוֹן","where Shemayah and Avtalyon answered"],["לְהַכֹּהֵן גָּדוֹל:","the Kohen Gadol:"],["״יֵיתוּן בְּנֵי עַמְמַיָּא לִשְׁלָם","\"Let the descendants of the nations go in peace"],["דְּעָבְדֵי עוֹבָדָא דְּאַהֲרֹן","who do the deeds of Aharon,\""],["וְכוּלֵּי״;","and so on;"],["הַיְינוּ שֶׁהֵם","that is, that they,"],["בְּכֹחָם הַגָּדוֹל","with their great power"],["וּבְכַוָּנוֹתֵיהֶם","and with their kavanos,"],["הִתְכַּוְּנוּ אָז","had in mind at that time"],["כָּל הַכַּוָּנוֹת","all the kavanos"],["שֶׁהָיָה צָרִיךְ הַכֹּהֵן גָּדוֹל לְכַוֵּין,","that the Kohen Gadol needed to have in mind,"],["וְרַק בְּכֹחָם","and only by their power"],["נִכְנַס אָז הַכֹּהֵן גָּדוֹל","did the Kohen Gadol then enter"],["לְקֹדֶשׁ הַקֳּדָשִׁים.","the Holy of Holies."],["וְאָז בְּאוֹתוֹ זְמַן","And at that time"],["הָיוּ הֵם, שְׁמַעְיָה וְאַבְטַלְיוֹן,","they, Shemayah and Avtalyon, were"],["הַגְּדוֹלֵי הַדּוֹר,","the great ones of the generation,"],["״דְּעָבְדוּ עוֹבָדֵי דְּאַהֲרֹן״,","\"who did the deeds of Aharon,\""],["וְהֵם הָיוּ","and they were"],["עִיקַּר כֹּחַ","the essential power"],["תּוֹרָה שֶׁבְּעַל פֶּה;","of the Torah she'b'al peh;"],["וּכְמוֹ שֶׁאָמַרְנוּ","and as we said,"],["שֶׁעַל יְדֵי זֶה הָיָה רָאוּי","that through this he was fit"],["לִהְיוֹת בְּקֹדֶשׁ הַקֳּדָשִׁים,","to be in the Holy of Holies,"],["מִפְּנֵי שֶׁהָיָה אַהֲרֹן","because Aharon was"],["שֹׁרֶשׁ תּוֹרָה שֶׁבְּעַל פֶּה.","the root of the Torah she'b'al peh."],["וְשָׁמַעְנוּ בְּשֵׁם","And we have heard in the name of"],["הַמַּגִּיד דְּקָאזִינִיץ","the Maggid of Kozhnitz,"],["זֵכֶר צַדִּיק לִבְרָכָה,","may the memory of the tzaddik be a blessing,"],["שֶׁאָמַר פַּעַם אַחַת","that he once said"],["בְּעֶרֶב יוֹם הַכִּפּוּרִים","on Erev Yom Kippur"],["שֶׁגַּם אָז בִּזְמַנּוֹ","that also then, in his time,"],["נִמְצָא כֹּחַ","the power is found"],["שְׁלֹשֶׁת הָאָבוֹת הַקְּדוֹשִׁים;","of the three holy Avos;"],["וְאָמַר עַל הָרַב הַקָּדוֹשׁ","and he said of the holy Rav"],["מֵאַפְּטָא,","of Apta,"],["בַּעַל אוֹהֵב יִשְׂרָאֵל","the author of Ohev Yisrael,"],["זֵכֶר צַדִּיק לִבְרָכָה,","may the memory of the tzaddik be a blessing,"],["שֶׁהוּא בְּחִינַת אַבְרָהָם;","that he is the aspect of Avraham;"],["וְעַל הָרַבִּי מִלּוּבְּלִין","and of the Rebbe of Lublin,"],["זֵכֶר צַדִּיק לִבְרָכָה,","may the memory of the tzaddik be a blessing,"],["שֶׁהוּא בְּחִינַת יִצְחָק;","that he is the aspect of Yitzchak;"],["וְאֶת עַצְמוֹ,","and himself,"],["שֶׁהָיָה שְׁמוֹ ״יִשְׂרָאֵל״,","whose name was Yisrael,"],["חָשַׁב כְּנֶגֶד","he reckoned as corresponding to"],["בְּחִינַת יַעֲקֹב;","the aspect of Yaakov;"],["רַק חָסֵר הַכֶּבֶשׂ","only the lamb is lacking"],["לְהַקְרִיב.","to offer."],["וְאָמַר שֶׁהוּא מְכַוֵּין","And he said that he has in mind"],["כָּל אוֹתָן הַכַּוָּנוֹת","all those kavanos"],["שֶׁל הַכֹּהֵן גָּדוֹל","of the Kohen Gadol"],["בְּהַקְרָבָם.","in their offering."],["וְהַמְכוּוָּן שֶׁלּוֹ","And his intent"],["מַה שֶּׁהִזְכִּיר","in mentioning"],["הַשְּׁלֹשָׁה אָבוֹת,","the three Avos"],["עַל פִּי הַמִּדְרָשׁ","is according to the Midrash"],["(וַיִּקְרָא רַבָּה כא, יא):","(Vayikra Rabbah 21:11):"],["״׳בְּפַר בֶּן בָּקָר׳","\"'With a young bull'"],["(וַיִּקְרָא טז, ג) –","(Vayikra 16:3) –"],["זֶה אַבְרָהָם","this is Avraham,"],["וְכוּלֵּי;","and so on;"],["׳וְאַיִל לְעֹלָה׳ –","'and a ram for an olah' –"],["זֶה יִצְחָק","this is Yitzchak,"],["וְכוּלֵּי;","and so on;"],["׳עֵז׳ –","'a goat' –"],["בִּזְכוּתוֹ שֶׁל יַעֲקֹב","in the merit of Yaakov,"],["וְכוּלֵּי״,","and so on,\""],["שֶׁנִּכְנַס עִמּוֹ","that there entered with him"],["זְכוּת הָאָבוֹת.","the merit of the Avos."],["וְעַל זֶה הִזְכִּיר","And on this basis he mentioned"],["שֶׁנִּמְצָא בַּדּוֹר שֶׁלּוֹ","that there are found in his generation"],["גַּם כֵּן הַקְּרוּיִם","also those called"],["בִּשְׁמוֹת הָאָבוֹת הַקְּדוֹשִׁים,","by the names of the holy Avos,"],["שֶׁהֵם בִּבְחִינָתָם;","who are in their aspect;"],["וְהַכַּוָּנוֹת","and the kavanos"],["יָכוֹל לְכַוֵּין,","he is able to have in mind,"],["כְּמוֹ שֶׁהָיוּ מְכַוְּנִים","just as the great ones of the generation"],["גְּדוֹלֵי הַדּוֹר","would have them in mind"],["בִּזְמַן שֶׁלֹּא הָיָה הַכֹּהֵן גָּדוֹל","at a time when the Kohen Gadol was not"],["רָאוּי לְכָךְ,","fit for this,"],["כַּנִּזְכָּר לְעֵיל.","as mentioned above."],["וְכֵיוָן שֶׁיָּכוֹל לִהְיוֹת","And since it is possible for"],["הַכַּוָּנוֹת עַל יְדֵי אַחֵר,","the kavanos to be done by another,"],["אָמַר שֶׁאֵין הַקָּרְבָּנוֹת","he said that the korbanos"],["מְעַכְּבִין.","are not indispensable."],["וְאִיתָא בַּמִּדְרָשׁ","And it is stated in the Midrash"],["(בְּרֵאשִׁית רַבָּה נו, ז):","(Bereishis Rabbah 56:7):"],["״אֵין דּוֹר","\"There is no generation"],["שֶׁאֵין בּוֹ כְּאַבְרָהָם","that does not have one like Avraham,\""],["וְכוּלֵּי״,","and so on;"],["וּבְתַנָּא דְּבֵי אֵלִיָּהוּ:","and in Tanna Devei Eliyahu:"],["״אֵין דּוֹר שֶׁאֵין בּוֹ","\"There is no generation that does not have"],["כְּאַבְרָהָם יִצְחָק וְיַעֲקֹב״;","ones like Avraham, Yitzchak and Yaakov\";"],["רַק שֶׁאֵין אָנוּ יוֹדְעִין","only that we do not know"],["מִי הֵם.","who they are."],["וְהֵם יְכוֹלִים לְכַוֵּין","And they are able to have in mind"],["כָּל הַכַּוָּנוֹת","all the kavanos"],["הָרְאוּיִן לְכֹהֵן גָּדוֹל.","that befit the Kohen Gadol."],["וְאַף שֶׁאֵין לָנוּ","And although we do not have"],["הַקָּרְבָּנוֹת,","the korbanos,"],["מִכָּל מָקוֹם כְּשֶׁנִּזְכֶּה,","nevertheless, when we merit,"],["נוּכַל לְתַקֵּן","we will be able to rectify"],["עַל יְדֵיהֶם,","through them,"],["שֶׁהֵם יְכַוְּונוּ","for they will have in mind"],["הַמְכוּוָּן שֶׁל הַקָּרְבָּנוֹת,","the intent of the korbanos,"],["וּלְתַקֵּן הַכֹּל","and to rectify everything"],["בְּיוֹם הַכִּפּוּרִים,","on Yom Kippur,"],["כְּמוֹ שֶׁהָיָה מְתַקֵּן","just as the Kohen Gadol"],["הַכֹּהֵן גָּדוֹל","would rectify"],["בְּהַכְנָסָתוֹ לְקֹדֶשׁ הַקֳּדָשִׁים;","upon his entering the Holy of Holies;"],["וּכְדִבְרֵי הַמַּגִּיד הַקָּדוֹשׁ","and in accordance with the words of the holy Maggid,"],["זֵכֶר צַדִּיק לִבְרָכָה.","may the memory of the tzaddik be a blessing."]],"keepPairs":true,"n":1,"unit":"m57p159"}]