  "findings": [
    {
      "id": "prayer-location",
      "unitId": "nc-he-c0c53cc65395354847fb",
      "sourceRef": "Sanhedrin 44b:7",
      "severity": "source-meaning precision",
      "before": "Had Abraham not prayed before the trouble between Bethel and Ai,",
      "after": "Had Abraham not prayed between Bethel and Ai before the trouble came,",
      "reason": "The location describes Abraham’s earlier prayer. The earlier English can instead attach the location to the later trouble. Root has agreed to this correction.",
      "proposedEnglish": "‘Have you set out your plea before distress?’ Rabbi Elazar said: A person should always pray before trouble comes. Had Abraham not prayed between Bethel and Ai before the trouble came, not one survivor or escapee would have remained among Israel, referred to here euphemistically as ‘the enemies of Israel.’ Reish Lakish said: Anyone who exerts himself in prayer below has no adversaries above. Rabbi Yochanan said: A person should always seek mercy that all will strengthen him and that he will have no adversaries above.",
      "beforeEnglishSHA256": "e59e2a9539ea9069a6634d9cca92f9b2fc69e0d18bda2826b314cac5e137d58c",
      "proposedEnglishSHA256": "f86385e70c5a99929f40db8306e29eb5c70d0a3697130608bc9d43f4190eb130",
      "status": "applied-exactly-and-independently-verified"
    },
    {
      "id": "envy-descriptive",
      "unitId": "nc-he-881145e60d1271954f19",
      "sourceRef": "Sanhedrin 105b:15",
      "severity": "small wording precision",
      "before": "A person may envy anyone except his own son and his student.",
      "after": "A person can feel envy toward anyone except his own son and his student.",
      "reason": "The source describes whom a person envies; “may” can accidentally sound like permission.",
      "proposedEnglish": "This differs from Rav Yosei bar Choni’s view, for Rav Yosei bar Choni said: A person can feel envy toward anyone except his own son and his student. The case of one’s son is learned from Solomon. As for one’s student, one may derive it from ‘Let a double portion of your spirit be upon me,’ or, alternatively, from ‘He laid his hands upon him and charged him.’",
      "beforeEnglishSHA256": "3c4633329c1471ac989bdc1221df4879563a5b8765fc1a0d36f1af90def3eb13",
      "proposedEnglishSHA256": "12b9a6233c07e07d2e184f250cb95ad87a5a6d48aead79d72919774a74d0d55c",
      "status": "applied-exactly-and-independently-verified"
    },
    {
      "id": "exact-quoted-words",
      "unitId": "nc-he-be29ead43c1cc42cb825",
      "sourceRef": "Berakhot 12b:22",
      "severity": "small quotation precision",
      "before": "‘After which you stray’ refers to thoughts of idolatry",
      "after": "‘You stray’ refers to thoughts of idolatry",
      "reason": "The supplied quoted Hebrew is אתם זונים. The words “after which” belong to the surrounding biblical verse and are not in this selected quotation.",
      "proposedEnglish": "For it was taught: ‘After your hearts’ refers to heresy, as another verse says, ‘The fool says in his heart: There is no God.’ ‘After your eyes’ refers to thoughts of sexual sin, as it is said, ‘Samson said to his father: Take her for me, for she is pleasing in my eyes.’ ‘You stray’ refers to thoughts of idolatry, as another verse says, ‘They strayed after the Baals.’",
      "beforeEnglishSHA256": "050dd31b23efbd2903ae238068f470383b4069e048190afd9e1c7ca2a2191e63",
      "proposedEnglishSHA256": "9b43a44692e878da5fbeaa1cdd03e3f11e3d418bcd6de479d70fc5f8c1a00c7b",
      "status": "applied-exactly-and-independently-verified"
    },
    {
      "id": "relations-wording",
      "unitId": "nc-he-45200f976535719d78dc",
      "sourceRef": "Megillah 13a:19-20",
      "severity": "small wording precision",
      "before": "he did not have marital relations during the day.",
      "after": "he did not have sexual relations during the day.",
      "reason": "משמש מטתו describes sexual relations; the selected episode does not establish marriage to each woman. This avoids an unnecessary marital implication.",
      "proposedEnglish": "‘In the evening she would come, and in the morning she would return.’ Rabbi Yochanan said: From this disgraceful account of that wicked man, we learn something to his credit: he did not have sexual relations during the day. ‘Esther won favor.’ Rabbi Elazar said: This teaches that each person thought she belonged to his own nation. ‘Esther was taken to King Ahasuerus, to his royal house, in the tenth month, which is the month of Tevet’—the month when one body takes pleasure in another’s warmth.",
      "beforeEnglishSHA256": "a64a64e36e91a48a97a0045ff62ce1baebb0933342c53441faa4c6e462c44053",
      "proposedEnglishSHA256": "87dff816aa2c15af78280b4cfc81afaed7e2ef713cde94e4fa7f381d40f98f17",
      "status": "applied-exactly-and-independently-verified"
    }
  ],
  "specialChecks": [
    {
      "sourceRef": "Sanhedrin 104b:15-105a:1",
      "disposition": "accepted",
      "reason": "Both folios form one complete unit. The Philistia refrain preserves the plain sense of התרועעי as a shout and the concluding דרש explicitly makes the figures friends. Rashi on Sanhedrin105a confirms the reconciliation/friendship sense of the concluding reply. Rashi on Psalms60:10 offers the related joining-under-rule reading; it does not require rejecting the draft’s plain rendering."
    },
    {
      "sourceRef": "Chullin 89a:10",
      "disposition": "accepted",
      "reason": "Silence, the deaf-mute comparison, Torah as the exception, and rejection of arrogance remain distinct. Hebrew-only Rashi confirms the craft/silence and level-ground readings."
    },
    {
      "sourceRef": "Eruvin 54b:5",
      "disposition": "accepted",
      "reason": "The rich-coverings/middin verse and its interpretation as judgment appear separately; the source’s scholar categories and resulting benefits are preserved."
    },
    {
      "sourceRef": "Bava Batra 16a:8",
      "disposition": "accepted",
      "reason": "The bracketed corrected reading in the supplied primary Hebrew is used; the deleted parenthetical alternative is not silently substituted."
