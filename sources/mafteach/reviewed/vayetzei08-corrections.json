 {
  "id": "vol7-0564-046630",
  "action": "fix_address",
  "index_text": "כד אתגזר אתחבר האי הי ושכינתא שריא ביה וכדין אקרי אברהם",
  "was": "Zohar I 91b",
  "correct": "Zohar I 93a",
  "correct_ref": null,
  "ref": "Peri Tzadik, Vayetzei 8",
  "quote": "מִכָּל מָקוֹם עַל יְדֵי הַמִּילָה וְעַמֵּךְ כֻּלָּם צַדִּיקִים (כְּמוֹ שֶׁכָּתוּב בַּזֹּהַר חֵלֶק א, צג עַמּוּד א)",
  "note": "Rav Tzadok cites I 93a (Lech Lecha, 'all who are circumcised are called tzaddikim'); the indexed words are not quoted in this os."
 },
 {
  "id": "vol7-0583-046895",
  "action": "fix_address",
  "index_text": "כל מאן דאתגזר איקרי צדיק",
